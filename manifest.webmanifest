{
  "name": "日序 DayFlow · 本地日程助理",
  "short_name": "日序",
  "description": "把日程和短期任务丢进来，自动生成行程，并在合适的时间提醒你。",
  "lang": "zh-CN",
  "start_url": "./#today",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
